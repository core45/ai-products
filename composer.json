{
    "name": "core45/ai-products",
    "description": "Product AI content services: product and category rewrite services and translation jobs.",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/core45/ai-core.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "astrotomic/laravel-translatable": "^11.17",
        "core45/ai-core": "^0.1",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Core45\\AiProducts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Core45\\AiProducts\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Core45\\AiProducts\\AiProductsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
